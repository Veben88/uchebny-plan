const ALIAS_KEYS = Object.keys(ALIASES).sort(function (a, b) { return b.length - a.length; });

function norm_(t) {
  return String(t || '').toLowerCase().replace(/ё/g, 'е').replace(/дв:/g, '').replace(/по выбору:/g, '')
    .replace(/\s+/g, ' ').replace(/^[\s.:]+|[\s.:]+$/g, '');
}
function stripHint_(t) { return String(t).replace(/\s*\([^()]*\)\s*$/, ''); }
function median_(a) {
  if (!a.length) return null;
  const s = a.slice().sort(function (x, y) { return x - y; }), m = Math.floor(s.length / 2);
  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
}
function colIndex_(head, part) {
  part = part.toLowerCase();
  for (let i = 0; i < head.length; i++) if (String(head[i]).toLowerCase().indexOf(part) >= 0) return i;
  return -1;
}
/** Чистая функция: принимает таблицу значений (первая строка заголовки), возвращает {slug: {n, hard, useful, interest}} */
function computeRatings(values, cfg) {
  cfg = cfg || CONFIG;
  const head = values[0] || [];
  let rows = values.slice(1).filter(function (r) { return r.some(function (c) { return String(c).trim() !== ''; }); });
  const ci = colIndex_(head, 'можно ли использовать твои ответы');
  if (ci >= 0) rows = rows.filter(function (r) { return String(r[ci]).trim().toLowerCase().indexOf('нет') !== 0; });
  if (cfg.ONLY_SPEC) {
    const fi = colIndex_(head, 'направлении');
    if (fi >= 0) rows = rows.filter(function (r) { return String(r[fi]).toLowerCase().indexOf(cfg.ONLY_SPEC.toLowerCase()) >= 0; });
  }
  const hard = {}, use = {}, interest = {}, unmatched = {};
  for (let i = 0; i < head.length; i++) {
    const col = String(head[i]), m = col.match(/^([\s\S]*?)\s*\[([\s\S]*)\]\s*$/);
    if (m) {
      const q = m[1].toLowerCase(), target = q.indexOf('сложным') >= 0 ? hard : q.indexOf('пригодился') >= 0 ? use : null;
      if (!target) continue;
      const slugs = ALIASES[norm_(m[2])] || ALIASES[norm_(stripHint_(m[2]))];
      if (!slugs) { unmatched[m[2]] = true; continue; }
      rows.forEach(function (r) {
        const v = String(r[i] == null ? '' : r[i]).trim();
        if (/^[1-5]/.test(v)) slugs.forEach(function (s) { (target[s] = target[s] || []).push(parseInt(v.charAt(0), 10)); });
      });
    } else if (col.toLowerCase().indexOf('самыми') >= 0 && col.toLowerCase().indexOf('интересн') >= 0) {
      rows.forEach(function (r) {
        let text = norm_(r[i]);
        ALIAS_KEYS.forEach(function (k) {
          if (k && text.indexOf(k) >= 0) { ALIASES[k].forEach(function (s) { interest[s] = (interest[s] || 0) + 1; }); text = text.replace(k, ''); }
        });
      });
    }
  }
  const out = {};
  Object.keys(hard).concat(Object.keys(use), Object.keys(interest)).forEach(function (s) {
    if (out[s]) return;
    const h = hard[s] || [], u = use[s] || [];
    out[s] = { n: Math.max(h.length, u.length), hard: median_(h), useful: median_(u), interest: interest[s] || 0 };
  });
  out.__unmatched = Object.keys(unmatched); out.__rows = rows.length;
  return out;
}
function buildPayload_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = CONFIG.SHEET_NAME ? ss.getSheetByName(CONFIG.SHEET_NAME) : ss.getSheets()[0];
  const all = computeRatings(sh.getDataRange().getValues());
  const ratings = {};
  Object.keys(all).forEach(function (s) { if (s.indexOf('__') !== 0 && all[s].n >= CONFIG.MIN_N) ratings[s] = all[s]; });
  return { updated: new Date().toISOString(), min_n: CONFIG.MIN_N, scope: CONFIG.SCOPE, ratings: ratings };
}
/** Веб-приложение: отдаёт JSON со сводкой */
function doGet() {
  const cache = CacheService.getScriptCache(), hit = cache.get('payload');
  let json = hit;
  if (!json) { json = JSON.stringify(buildPayload_()); cache.put('payload', json, CONFIG.CACHE_SEC); }
  return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);
}
/** Запустите вручную один раз: проверка настройки */
function checkSetup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = CONFIG.SHEET_NAME ? ss.getSheetByName(CONFIG.SHEET_NAME) : ss.getSheets()[0];
  const all = computeRatings(sh.getDataRange().getValues());
  Logger.log('Лист: ' + sh.getName() + '. Ответов учтено: ' + all.__rows);
  Logger.log('Предметов с оценками: ' + Object.keys(all).filter(function (s) { return s.indexOf('__') !== 0; }).length);
  Logger.log('Будет показано на сайте (минимум ' + CONFIG.MIN_N + ' ответов): ' + Object.keys(buildPayload_().ratings).length);
  Logger.log(all.__unmatched.length ? 'Не удалось сопоставить: ' + all.__unmatched.join(' | ') : 'Все строки формы сопоставлены.');
}
